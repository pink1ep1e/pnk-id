# Database — PostgreSQL
DATABASE_URL="postgresql://pnk:pnk@localhost:5432/pnk_id?schema=public"

APP_URL="http://localhost:3100"
COOKIE_NAME="pnk_id_session"
SESSION_SECRET="change-me-pnk-id-local-dev-secret-min-32-chars"
JWT_SECRET="change-me-pnk-id-jwt-secret-min-32-chars!!"
NEXT_PUBLIC_MAIL_URL="http://localhost:3000"

# Nest API base (empty = same origin /v1 via Nginx). Local: http://localhost:3101
NEXT_PUBLIC_ID_API_URL=""
# Cloudflare Turnstile site key (widget). Secret stays in api/.env
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Same value as pnk-mail PNK_ID_CLIENT_SECRET (used by seed)
PNK_ID_CLIENT_SECRET="pnk-mail-dev-secret"

# Internal admin API for pnk-pmp (Bearer). Generate: openssl rand -hex 32
ADMIN_API_TOKEN=""
